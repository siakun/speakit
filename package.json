{
  "name": "speakit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "node --disable-warning=ExperimentalWarning --test tests/content.test.mjs tests/deck.test.mjs",
    "test:e2e": "playwright test",
    "deck:export": "node --disable-warning=ExperimentalWarning scripts/export-deck.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
